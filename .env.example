# --- Local development: individual connection settings ---
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydatabase

# --- Deployment: a single hosted-Postgres connection string ---
# If DATABASE_URL is set it wins over the DB_* vars above and TLS is enabled.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

PORT=5000
JWT_SECRET=change_me_to_a_long_random_string
SHARED_PASSWORD=1234
